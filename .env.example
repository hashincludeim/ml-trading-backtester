# Copy to .env (read automatically by web/config/settings/base.py) or export in your shell.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_SECURE_COOKIES=false

# Parquet price cache, training artefacts and the SQLite DB live here.
DATA_DIR=./data
# DATABASE_PATH=./data/db.sqlite3
CACHE_TIMEOUT=3600
LOG_LEVEL=INFO
